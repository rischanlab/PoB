{
  "name": "rwa-pob-usdy-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Research prototype for a credential-based proof-of-backing policy layer calibrated to USDY-like Treasury tokens.",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:unit": "hardhat test test/PoBPolicyController.ts",
    "experiment": "hardhat test test/ExperimentResults.ts",
    "experiment:atomic-gas": "hardhat test test/AtomicGasResults.ts",
    "coverage": "hardhat test --coverage",
    "prepare:usdy": "node scripts/prepare-usdy-data.mjs",
    "generate:data": "node scripts/generate-reserve-data.mjs",
    "test:v2": "hardhat test test/V2ReviewFixes.ts",
    "experiment:real": "RWA_POB_REAL_REPLAY=1 hardhat test test/RealDataReplay.ts",
    "validate:treasury": "python3 scripts/validate-treasury-bill-rates.py data/raw/treasury/*.csv",
    "fetch:treasury": "bash scripts/fetch-treasury-bill-rates.sh",
    "prepare:franklin": "python3 scripts/prepare-franklin-nmfp3.py data/raw/franklin/fobxx-nmfp3-2026-09-30.xml",
    "build:franklin": "node scripts/build-franklin-snapshot.mjs",
    "experiment:real-positions": "hardhat test test/RealPositionSnapshot.ts",
    "reconcile:franklin": "node scripts/reconcile-snapshot.mjs",
    "experiment:fobxx-flows": "hardhat test test/FobxxDailyFlows.ts",
    "experiment:trust": "hardhat test test/TrustModel.ts",
    "test:persistent": "hardhat test test/PersistentController.ts",
    "prepare:usdy-supply": "node scripts/prepare-usdy-supply.mjs",
    "test:price": "hardhat test test/VariablePrice.ts",
    "experiment:fobxx-monthly": "hardhat test test/FobxxMonthly.ts",
    "build:franklin-monthly": "for d in 2026-05-31 2026-06-30 2026-07-31 2026-08-31; do python3 scripts/prepare-franklin-nmfp3.py data/raw/franklin/fobxx-nmfp3-$d.xml - data/input/franklin-fobxx-monthly/$d && node scripts/build-franklin-snapshot.mjs data/input/franklin-fobxx-monthly/$d; done",
    "reconcile:franklin-monthly": "for d in data/input/franklin-fobxx-monthly/*/; do node scripts/reconcile-snapshot.mjs $d/tree.json $d/snapshot.json $d/fund.json || exit 1; done"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "^22.15.0",
    "hardhat": "3.11.1",
    "typescript": "^5.8.3",
    "viem": "2.55.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/merkle-tree": "1.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
